{
  "name": "skymp-yaca-ts",
  "version": "1.0.0",
  "description": "SkyMP YACA voice bridge",
  "main": "dist/yacaBridge.js",
  "types": "dist/yacaBridge.d.ts",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc && node tools/build-ui.cjs && node tools/build-plugin.cjs",
